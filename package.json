{
  "name": "gibstaapp",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "test": "npm test -w server",
    "build": "npm run build -w web",
    "start": "npm run build -w web && npm start -w server",
    "refresh": "npm run refresh -w server",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "autostart": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1"
  }
}
